# Local Docker database: docker compose up -d
DATABASE_URL=postgresql://ingenium:ingenium_local@localhost:5438/ingenium_demo
# false: a private guest workspace for each browser. true: local-only shared sample data.
DEMO_MODE=false
# Uploaded bytes stay outside the public directory. Use durable storage in hosted environments.
STORAGE_PATH=
# Optional. Deterministic labs, practice, planning and files work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=15

# Optional S3-compatible object storage for a host without a persistent disk.
# Existing local objects retain their local locator when switching providers.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
AI_MAX_OUTPUT_TOKENS=2200

# Search and playlist import. Enable YouTube Data API v3 for this server-side key.
YOUTUBE_API_KEY=
# On Vercel, use STORAGE_PROVIDER=vercel-blob and a connected private Blob store.
BLOB_READ_WRITE_TOKEN=
